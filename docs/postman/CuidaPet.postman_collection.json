{
  "info": {
    "name": "CuidaPet Backend",
    "description": "Bloque de Juan Pablo: autenticación y CRUD de cinco entidades de seguridad. Ejecutar toda la colección con una cuenta ACTIVE que tenga MANAGE_USERS y MANAGE_ROLES. Requiere OWNER activo con permisos. Crea datos únicos y elimina roles/permisos al finalizar; el usuario permanece en estado DELETED por la regla de borrado lógico. Los demás bloques se añadirán posteriormente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Sin token: 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"runId\", Date.now().toString() + Math.floor(Math.random() * 100000).toString());",
                  "[\"permissionAId\",\"permissionBId\",\"permissionCId\",\"roleAId\",\"roleBId\",\"ownerRoleId\",\"createdUserId\",\"token\"].forEach(key => pm.environment.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error JSON\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token inválido: 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid-token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Datos inválidos: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{loginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"token\");",
                  "const email = pm.environment.get(\"email\");",
                  "const password = pm.environment.get(\"password\");",
                  "if (!email || !password) { throw new Error(\"Configura email y password de una cuenta existente en el entorno local.\"); }",
                  "pm.variables.set(\"loginBody\", JSON.stringify({email, password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Token y vencimiento\", () => { pm.expect(data.accessToken).to.be.a(\"string\"); pm.expect(data.tokenType).to.eql(\"Bearer\"); pm.expect(new Date(data.expiresAt).getTime()).to.be.above(Date.now()); });",
                  "  pm.environment.set(\"token\", data.accessToken);",
                  "}",
                  "pm.test(\"Sin contraseña en respuesta\", () => { const data = pm.response.json(); pm.expect(data).not.to.have.property(\"password\"); pm.expect(data).not.to.have.property(\"passwordHash\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Usuario correcto\", () => pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"email\").trim()));",
                  "pm.test(\"Roles y permisos\", () => { pm.expect(pm.response.json().roles).to.be.an(\"array\"); pm.expect(pm.response.json().permissions).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
