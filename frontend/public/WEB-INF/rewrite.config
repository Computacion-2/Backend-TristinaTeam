# Las navegaciones de la SPA reciben el index; los archivos usan el servlet estático.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_ACCEPT} .*text/html.* [NC]
RewriteCond $0 !-f
RewriteCond $0 !-d
RewriteRule ^/(?!assets(?:/|$)|WEB-INF(?:/|$)|META-INF(?:/|$))(?!.*\.[^/]+$).+ /index.html [NC,L]
